# Copy to .env and fill in. See README.md.

# StatusNest Next.js app (internal API)
STATUSNEST_API_URL=http://localhost:3000
# Same value as nextjs_statusnest's BACKGROUND_PROCESSOR_API_KEY
API_KEY=<same-as-BACKGROUND_PROCESSOR_API_KEY>

# How often to ask for due sites (ms). The 5–20 minute check jitter is decided server-side.
POLL_INTERVAL_MS=30000
# Per-page navigation timeout (ms)
NAVIGATION_TIMEOUT_MS=30000
# Set to 1 to run Chromium headless (no virtual display needed, e.g. on a laptop).
# Leave unset in the container: xvfb-run provides a display and Chromium runs headed.
# BROWSER_HEADLESS=1
