{
  "name": "browser_checker",
  "version": "1.0.0",
  "private": true,
  "description": "Visits StatusNest's public monitor sites from a real Chromium browser (headed, under Xvfb) and reports per-page availability",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx src/block-detection.test.ts",
    "verify-sites": "node dist/verify-sites.js"
  },
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.2.2",
    "playwright": "1.62.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
