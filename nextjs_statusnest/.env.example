# Copy to .env.local and fill in. See README.md.

DATABASE_PATH=./data
SESSION_SECRET=<random-32-char-string>
BACKGROUND_PROCESSOR_API_KEY=<random-32-char-string>

# Offline alerts via AlertTray (phone call + SMS + email when a domain goes offline).
# Create an account at https://alerttray.com and generate an API key (atk_...).
# Without ALERTTRAY_API_KEY, offline alerts are recorded as failed and logged instead of sent.
ALERTTRAY_API_URL=https://alerttray.com
ALERTTRAY_API_KEY=atk_<api-key-from-alerttray-dashboard>

# Base URL for canonical links, sitemap.xml and JSON-LD on the public status pages.
NEXT_PUBLIC_SITE_URL=https://statusnest.com
